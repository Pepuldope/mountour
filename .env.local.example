# Copy this file to .env.local and fill in your own Supabase project's values.
# If these are left unset (or the project is unreachable), the app falls back
# to reading data/fixtures/trails.json so `npm run dev` works standalone.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Drive leg (start -> parking). Free key from https://openrouteservice.org/dev/#/signup
# Server-side only. Without it, /api/drive falls back to the public OSRM demo (dev only).
ORS_API_KEY=

# Optional overrides of lib/site.ts (not secret).
# NEXT_PUBLIC_SITE_URL=https://mountour.sk
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
