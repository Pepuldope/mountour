# Copy this file to .env.local and fill in your own Supabase project's values.
# If these are left unset (or the project is unreachable), the app falls back
# to reading data/fixtures/trails.json so `npm run dev` works standalone.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
