# Copy this file to .env.local. Everything is optional: `npm run dev` works without it,
# reading the trip files in public/data.

# Drive leg (start -> parking). Free key from https://openrouteservice.org/dev/#/signup
# Server-side only. Without it, /api/drive falls back to the public OSRM demo (dev only).
ORS_API_KEY=

# Optional overrides of lib/site.ts (not secret).
# NEXT_PUBLIC_SITE_URL=https://turuj.sk
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
