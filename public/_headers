# Cloudflare static assets (files served without the Worker).
# Built scripts, styles and fonts have their content hash in the name: keep them
# a year, so a repeat visit doesn't re-check each one.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
