{
  "name": "turuj",
  // worker.ts answers pages built ahead itself and hands the rest to OpenNext (.open-next/worker.js).
  "main": "worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Workers Logs (Observability tab): every request and error with its URL, so
  // errors can be traced (A18, 2026-10-28). Free up to 200k events a day; above
  // that Cloudflare samples.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Visit-day counter (lib/visitStore.ts). No database_id on purpose: the
  // first deploy creates the free D1 database and later deploys reuse it.
  "d1_databases": [{ "binding": "VISITS_DB", "database_name": "mountour-visits" }],
  // Finished trip pages (lib/pageCache.ts), so the Worker doesn't draw them on
  // every visit. No id on purpose: the first deploy creates the free KV store.
  "kv_namespaces": [{ "binding": "PAGE_CACHE" }],
  // New routes per visitor a minute (lib/routeGuard.ts), so a script can't spend
  // the free OpenRouteService quota for everyone. Free; namespace_id is any number
  // unique within the account.
  // COUNT_LIMIT: the usage counters, saved reviews and the trip list, keyed per use.
  // READ_LIMIT: new weather and review-totals answers, looser so a whole class on
  // one school address can open different trips at once (load test, 2026-10-27).
  "ratelimits": [
    { "name": "ROUTE_LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "COUNT_LIMIT", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "READ_LIMIT", "namespace_id": "1003", "simple": { "limit": 300, "period": 60 } }
  ]
}
